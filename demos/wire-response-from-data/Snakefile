    output:
        f"{FIGS}/scan-scmesh.tex",
        f"{FIGS}/scan-scmesh.pdf",
    log:
        f"{R}/logs/scan-scmesh.txt",
    shell:
        scan_shell("scmesh", MESH_MODELS, param="mesh depth below W [mm]")


# The untuned Garfield bad-APA response, usable wherever a prior is.
rule garfield_untuned:
    input:
        UNTUNED,
    output:
        f"{R}/prior/garfield-untuned.json.bz2",
    shell:
        "cp {input} {output}"


# Physical projections: fit each impact bin as a non-negative composition of
# firep paths shared by all planes and wires (scripts/project_truth.py).
# shift only (stretch fixed at 1): learner 2 has no stretch, so B2' stays representable
PROJ_GRID = "--shift 3.0,4.6,0.05 --stretch 1.0,1.0,0.01 --shaping 2.2"


# Hidden side: the tuned truth projected onto firep at the floating
# equilibrium.  Its frames are pseudo-data (B2'), never a prior.
rule proj_truth:
    input:
        target=BAD,
        basis=f"{FR_}/resp/response-vwfloatm4.71b.npz",
        script="scripts/project_truth.py",
        helper="scripts/firep_to_wct.py",
    output:
        fr=f"{R}/truth/proj-vwfloat.json.bz2",
        tex=f"{FIGS}/proj-prtruth.tex",
        pdf=f"{FIGS}/proj-prtruth.pdf",
    shell:
        "{ENV}; {PY} {input.script} {input.target} {input.basis} {output.fr} {FIGS}"
        " --tag prtruth " + PROJ_GRID


# Prior side: the untuned Garfield file projected onto firep at V_W = 0.
rule proj_untuned:
