# Scoring side: truth vs the firep floating-W prior vs V_W = 0, path by path.
rule paths_truth:
    input:
        truth=BAD,
        fl=f"{R}/prior/vwfloatm4.71b.json.bz2",
        z=f"{R}/prior/vw0b.json.bz2",
        script="scripts/path_compare.py",
    output:
        pdf=f"{FIGS}/paths-truth.pdf",
        tex=f"{FIGS}/paths-truth.tex",
    shell:
        "{ENV}; {PY} {input.script} {output.pdf} --tex {output.tex} --tag pt"
        " {input.truth}:'G-bad-T' {input.fl}:'P$_b$(float)':3.6"
        " {input.z}:'P$_b$(0)':3.6"


# S6, learner 2: composition weights w_k(d) >= 0 per impact bin, shared by all
# planes and wires, fitted to ADC.  WCT is linear in the field response, so the
# model is sum_c w_c S_c with S_c the analog WCT simulation of one component
# response (scripts/component_fr.py); fitted by NNLS (scripts/learner2.py).
L2 = config["l2"]
L2R = f"{R}/l2"
# components are named by offset in hundredths of a pitch: c<bin>_<d*100>
L2COLS = [(int(k), int(round(100 * float(d))), float(d)) for k, ds in L2["offsets"].items()
          for d in ds]


rule l2_windows:
    input:
        ref=fit_frames("vwfloat"),
        script="scripts/l2_crop.py",
    output:
        f"{L2R}/windows.npz",
    shell:
        "{ENV}; {PY} {input.script} windows {input.ref} {output} --anode {A}"


def l2_offset(w):
    return int(w.j) / 100.0


rule l2_component_fr:
    input:
        fine=f"{FR_}/resp/response-{L2['basis']}.npz",
        cfg=FDRIFT,
        script="scripts/component_fr.py",
        helper="scripts/firep_to_wct.py",
    output:
        f"{L2R}/fr/c{{k}}_{{j}}.json.bz2",
    params:
        d=l2_offset,
    shell:
        "{ENV}; {PY} {input.script} {input.fine} {output} --config {input.cfg}"
        " --bin {wildcards.k} --offset={params.d}"


rule l2_column:
    input:
        depos=rules.depos_fit.output,
        fr=f"{L2R}/fr/c{{k}}_{{j}}.json.bz2",
        windows=rules.l2_windows.output,
        script="scripts/l2_crop.py",
    output:
        f"{L2R}/col/c{{k}}_{{j}}.npz",
    log:
        f"{R}/logs/l2_column-c{{k}}_{{j}}.log",
    params:
        tmp=f"{L2R}/tmp/c{{k}}_{{j}}.npz",
    shell:
        "{ENV}; mkdir -p {L2R}/tmp; wire-cell -l {log} -L info"
        " -V elecGain={config[sim][gain_mV_fC]}"
        " -A depos={input.depos} -A frames={params.tmp}"
        " -A fr_bad={input.fr} -A fr_good={GOOD} -A anodes='[{A}]'"
        " -A digitize=false -c cfg/sim-laser.jsonnet"
        " && {PY} {input.script} crop {params.tmp} {input.windows} {output}"
        " --anode {A} --scale {L2[adc_per_unit]}"
        " && rm -f {params.tmp}"


rule l2_columns_json:
    input:
        [f"{L2R}/col/c{k}_{j}.npz" for k, j, _ in L2COLS],
    output:
        f"{L2R}/columns.json",
    run:
        json.dump([{"bin": k, "offset": d, "path": f"{L2R}/col/c{k}_{j}.npz"}
                   for k, j, d in L2COLS], open(output[0], "w"), indent=1)


L2REFS = {"lbone": fit_frames("vwfloat"), "lbproj": f"{R}/frames/fit/data-proj.npz",
          "lbtwo": f"{R}/frames/fit/data.npz"}
# plane-balanced variants (tag ending in "bal")
L2REFS.update({t + "bal": p for t, p in list(L2REFS.items())})


rule l2_fit:
    input:
        data=lambda w: L2REFS[w.tag],
        windows=rules.l2_windows.output,
        cols=rules.l2_columns_json.output,
        script="scripts/learner2.py",
    output:
        tex=f"{FIGS}/l2-{{tag}}.tex",
        pdf=f"{FIGS}/l2-{{tag}}.pdf",
        weights=f"{L2R}/weights-{{tag}}.json",
    log:
        f"{R}/logs/l2-{{tag}}.txt",
    params:
        shift=lambda w: ",".join(str(x) for x in L2["shift_ticks"][w.tag.removesuffix("bal")]),
        bal=lambda w: " --balance" if w.tag.endswith("bal") else "",
    shell:
        "{ENV}; {PY} {input.script} {input.data} {input.windows} {FIGS}"
        " --tag {wildcards.tag} --columns {input.cols} --shift={params.shift}"
        " --noise {FIT[noise_adc]} --anode {A} --weights-out {output.weights}{params.bal} > {log}"


# The learned response as a WCT file, for scoring and re-simulation.
rule l2_learned_fr:
    input:
        fine=f"{FR_}/resp/response-{L2['basis']}.npz",
        weights=f"{L2R}/weights-{{tag}}.json",
        cfg=FDRIFT,
        script="scripts/component_fr.py",
        helper="scripts/firep_to_wct.py",
    output:
        f"{L2R}/learned-{{tag}}.json.bz2",
    shell:
        "{ENV}; {PY} {input.script} {input.fine} {output} --config {input.cfg}"
        " --weights {input.weights}"


# Scoring side: truth vs what learner 2 learned from its ADC, path by path.
rule paths_l2:
    input:
        truth=BAD,
        learned=f"{L2R}/learned-lbtwo.json.bz2",
        prior=f"{R}/prior/{L2['basis']}.json.bz2",
        script="scripts/path_compare.py",
    output:
        pdf=f"{FIGS}/paths-l2.pdf",
        tex=f"{FIGS}/paths-l2.tex",
    shell:
        "{ENV}; {PY} {input.script} {output.pdf} --tex {output.tex} --tag pl"
        " {input.truth}:'G-bad-T' {input.learned}:'L2[G-bad-T]':3.75"
        " {input.prior}:'P$_b$(float)':3.75"


# Held-out prediction (App. A's third criterion): a disjoint set of shots,
# simulated with each learned response and compared with held-out data.
HOLD = f"{R}/frames/hold"


rule depos_hold:
    input:
        depos=rules.laser_depos.output.depos,
        script="scripts/subset.py",
    output:
        f"{R}/depos/hold.npz",
    shell:
        "{ENV}; {PY} {input.script} depos {input.depos} {output}"
        " --stride {FIT[stride]} --first {FIT[holdout_first]}"


rule data_hold:
    input:
        frames=rules.data.output,
        script="scripts/subset.py",
    output:
        f"{HOLD}/data.npz",
    shell:
        "{ENV}; {PY} {input.script} frames {input.frames} {output}"
        " --stride {FIT[stride]} --first {FIT[holdout_first]}"


HOLD_FR = {"data-proj": f"{R}/truth/proj-vwfloat.json.bz2",        # B2' truth (hidden)
           "learned-lbtwo": f"{L2R}/learned-lbtwo.json.bz2",
           "learned-lbproj": f"{L2R}/learned-lbproj.json.bz2",
           "learned-lbtwobal": f"{L2R}/learned-lbtwobal.json.bz2",
           "prior": f"{R}/prior/{L2['basis']}.json.bz2"}


rule sim_hold:
    wildcard_constraints:
        name="|".join(re.escape(k) for k in ["data-proj", "learned-lbtwo", "learned-lbproj",
                                             "learned-lbtwobal", "prior"]),
    input:
        depos=rules.depos_hold.output,
        fr=lambda w: HOLD_FR[w.name],
    output:
        f"{HOLD}/{{name}}.npz",
    log:
        f"{R}/logs/sim_hold-{{name}}.log",
    shell:
        sim_shell("{input.fr}", anodes=[A])


# tag: (reference, model)
HOLD_TESTS = {"hotwo": ("data", "learned-lbtwo"), "hotwobal": ("data", "learned-lbtwobal"),
              "hotwoprior": ("data", "prior"),
              "hoproj": ("data-proj", "learned-lbproj"), "hoprojprior": ("data-proj", "prior")}


rule hold_test:
    input:
        ref=lambda w: f"{HOLD}/{HOLD_TESTS[w.tag][0]}.npz",
        model=lambda w: f"{HOLD}/{HOLD_TESTS[w.tag][1]}.npz",
        script="scripts/scan_loss.py",
    output:
        f"{FIGS}/scan-{{tag}}.tex",
        f"{FIGS}/scan-{{tag}}.pdf",
    wildcard_constraints:
        tag="ho[a-z]+",
    log:
        f"{R}/logs/scan-{{tag}}.txt",
    shell:
        "{ENV}; {PY} {input.script} {input.ref} {FIGS} --tag {wildcards.tag} --anode {A}"
        " --noise {FIT[noise_adc]} --tmax {FIT[tmax_ticks]} --param model -- 0={input.model}"
        " > {log}"


# S5: differentiable forward model vs WCT (Garfield good FR on the control).
rule forward_closure:
    input:
        depos=rules.laser_depos.output.depos,
        frames=f"{R}/frames/prior-bc-exact.npz",
    output:
        f"{FIGS}/closure.tex",
    shell:
        skeleton("S5")


# S6: fit.  Sees the prior, the depos and the data frames -- never the truth.
rule fit:
    input:
        depos=rules.laser_depos.output.depos,
        data=rules.data.output,
        prior=f"{R}/prior/{{name}}.json.bz2",
        closure=rules.forward_closure.output,
    output:
        f"{R}/fit/{{name}}/learned-fr.json.bz2",
    shell:
        skeleton("S6")


# S7: score the learned FR against truth, and re-simulate it in WCT.
rule score:
    input:
        learned=f"{R}/fit/{{name}}/learned-fr.json.bz2",
        truth=BAD,
        prior=f"{R}/prior/{{name}}.json.bz2",
    output:
        f"{FIGS}/score-{{name}}.tex",
    shell:
        skeleton("S7")
