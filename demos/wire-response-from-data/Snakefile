# Recipes for the wire-response-from-data demo (ProtoDUNE-HD).  See design.md.
#
#     snakemake -c4 -n            # what would run
#     snakemake -c4 note          # everything the note needs, then the PDF
#     snakemake -c1 laser_coverage
#
# Every rule sources env.sh.  Rules marked SKELETON fail with a message until
# their step in design.md is implemented.
#
# Hidden-truth discipline: config["bad_fr"] is the truth.  It is read by the
# `data` rule (making the pseudo-data) and by scoring rules (`fr_good_bad`,
# `score`).  Nothing a fit consumes may depend on those rules except through
# the data frames.

import json
import os
import re

configfile: "config.yaml"

wildcard_constraints:
    plane="[uvw]",
    mesh=r"\d+(\.\d+)?",

os.environ.setdefault("XEROSERE_TOP", os.path.expanduser("~/dune/xerosere"))
X = lambda s: os.path.expandvars(os.path.expanduser(str(s)))

R = config["rundir"]
FIGS = "note/figs"
GOOD = X(config["good_fr"])
BAD = X(config["bad_fr"])
UNTUNED = X(config["bad_untuned_fr"])
WIRES = X(config["wires"])
LASER = config["laser"]
A, C = config["anode"], config["control_anode"]
ENV = "source env.sh"
PY = "$DEMO_PYTHON"
csv3 = lambda v: ",".join(str(x) for x in v)


def skeleton(step):
    return f"echo 'SKELETON: implement design.md step {step}' >&2; exit 1"


rule note:
    input:
        f"{FIGS}/apa-numbering.pdf",
        f"{FIGS}/setup.tex",
        f"{FIGS}/fr-frgb.tex",
        f"{FIGS}/laser-coverage.tex",
        f"{FIGS}/firep-landing.tex",
        f"{FIGS}/fr-frbone.tex",
        f"{FIGS}/frames-data.tex",
        f"{FIGS}/scan-scbone.tex",
        f"{FIGS}/scan-scbtwo.tex",
        f"{FIGS}/scan-scbtwobin.tex",
        f"{FIGS}/scan-scmesh.tex",
        f"{FIGS}/paths-truth.tex",
        f"{FIGS}/proj-prtruth.tex",
        f"{FIGS}/proj-pruntuned.tex",
        f"{FIGS}/scan-scbzero.tex",
        f"{FIGS}/scan-scbzerobin.tex",
        f"{FIGS}/scan-scbproj.tex",
        f"{FIGS}/l2-lbone.tex",
        f"{FIGS}/l2-lbproj.tex",
        f"{FIGS}/l2-lbtwo.tex",
        f"{FIGS}/l2-lbprojbal.tex",
        f"{FIGS}/l2-lbtwobal.tex",
        f"{FIGS}/paths-l2.tex",
        expand(f"{FIGS}/scan-{{tag}}.tex",
               tag=["hotwo", "hotwobal", "hotwoprior", "hoproj", "hoprojprior"]),
    output:
        "note/wrfd.pdf",
    shell:
        "make -C note pdf"


rule check_env:
    output:
        f"{R}/env.txt",
    shell:
        "{ENV}; bash scripts/check-env.sh > {output}"


# Sec. 2: run settings as macros.
