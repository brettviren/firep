        script="scripts/numbering_fig.py",
    output:
        f"{FIGS}/apa-numbering.pdf",
    shell:
        "{ENV}; {PY} {input.script} {input.wires} {output}"


# S1 (scoring side): good vs bad Garfield -- why approach A is ruled out.
rule fr_good_bad:
    input:
        good=GOOD,
        bad=BAD,
        script="scripts/fr_compare.py",
    output:
        f"{FIGS}/fr-frgb.tex",
        f"{FIGS}/fr-frgb.pdf",
    shell:
        "{ENV}; {PY} {input.script} {input.good} {input.bad} {FIGS}"
        " --tag frgb --labels 'G-nom,G-bad-T'"


# S2: what the recorded laser shots cover, as recorded and shifted.
rule laser_coverage:
    input:
        csv=LASER["csv"],
        wires=WIRES,
        script="scripts/laser_coverage.py",
    output:
        f"{FIGS}/laser-coverage.tex",
        f"{FIGS}/laser-coverage.pdf",
    params:
        shift=csv3(LASER["shift_mm"]),
        flip=csv3(LASER["flip"]),
    shell:
        "{ENV}; {PY} {input.script} {input.wires} {FIGS} {input.csv}"
        " --anode {A} --control {C} --shift={params.shift} --flip={params.flip}"


rule anode_box:
    input:
        wires=WIRES,
        script="scripts/wires.py",
    output:
        f"{R}/geom/anode{{anode}}-box.txt",
    shell:
        "{ENV}; {PY} {input.script} {input.wires} {wildcards.anode}"
        " --cathode-x {config[cathode_x_mm]} > {output}"


# S2: laser shots -> depos.  The box spans the target anode and the control
# (they are adjacent in z) so each track is kept on both.
rule laser_depos:
    input:
        csv=LASER["csv"],
        box_t=f"{R}/geom/anode{A}-box.txt",
        box_c=f"{R}/geom/anode{C}-box.txt",
        script="scripts/laser_depos.py",
    output:
        depos=f"{R}/depos/laser.npz",
        tracks=f"{R}/depos/laser-tracks.npz",
        summary=f"{R}/depos/laser.json",
    params:
        shift=csv3(LASER["shift_mm"]),
        flip=csv3(LASER["flip"]),
    shell:
        "{ENV}; box=$({PY} -c \"import numpy as n;"
        " a=n.loadtxt('{input.box_t}',delimiter=',');b=n.loadtxt('{input.box_c}',delimiter=',');"
        " print(','.join(f'{{v:.2f}}' for v in [*n.minimum(a[:3],b[:3]),*n.maximum(a[3:],b[3:])]))\");"
        " {PY} {input.script} {output.depos} {input.csv} --box=$box --shift={params.shift} --flip={params.flip}"
        " --stride {LASER[stride]} --per-event {LASER[per_event]}"
        " --step {LASER[step_mm]} --dqdx {LASER[dqdx_per_mm]} --index {LASER[index]}"
        " --tracks {output.tracks} --summary {output.summary}"


# S3: WCT simulation, anode 0 with a given field response, others nominal.
def sim_shell(fr, anodes=None):
    S = config["sim"]
    anodes = anodes or [A, C]
    return (ENV + "; wire-cell -l {log} -L info"
            f" -V elecGain={S['gain_mV_fC']}"
            " -A depos={input.depos} -A frames={output}"
            f" -A fr_bad={fr} -A fr_good={GOOD}"
            f" -A anodes='{json.dumps(anodes, separators=(",", ":"))}'"
            f" -A noise={str(S['noise']).lower()}"
            f" -A fluctuate={str(S['fluctuate']).lower()}"
            f" -A seeds='{json.dumps(S['seeds'])}'"
            " -c cfg/sim-laser.jsonnet")


# The pseudo-data.  Reads the hidden truth.
rule data:
    input:
        depos=rules.laser_depos.output.depos,
    output:
        f"{R}/frames/data.npz",
    log:
        f"{R}/logs/data.log",
    shell:
        sim_shell(BAD)


# S4: firep models of the bad-APA cell (firep/bad-apa-*.yaml).  The drift
# solves use the analytic basis alone: exactly harmonic, seconds on a CPU.
FDRIFT = "firep/bad-apa-drift.yaml"
FWEIGHT = "firep/bad-apa-weighting.yaml"
FR_ = f"{R}/firep"
FSET = "--steps 0 --set model.final_init_scale=0"


rule firep_landing:
    input:
        cfg=FDRIFT,
        script="scripts/firep_landing.py",
    output:
        f"{FIGS}/firep-landing.tex",
        f"{FIGS}/firep-landing.pdf",
    params:
        out=f"{FR_}/landing",
    shell:
        "{ENV}; {PY} {input.script} {input.cfg} {params.out}"
        " --vw=0,-10,-20,-30,-40,-43,-44,-45,-46,-47,-50,-60,-80,-100,-120,-140,-160,-200"
        " && cp {params.out}/firep-landing.tex {params.out}/firep-landing.pdf {FIGS}/"


# The floating-equilibrium W potential: least negative V_W with no W landing.
VFLOAT_SCAN = "--bisect=-20,-300,0.5 --n 4710"


def vfloat_shell(extra=""):
    return ("{ENV}; {PY} {input.script} {input.cfg} {params.out} " + VFLOAT_SCAN + extra +
            " && {PY} -c \"import json; d=json.load(open('{params.out}/firep-landing.json'));"
            " print(d[-1]['vfloat_estimate'])\" > {output}")


rule firep_vfloat:
    input:
        cfg=FDRIFT,
        script="scripts/firep_landing.py",
    output:
        f"{FR_}/vfloat.txt",
    params:
        out=f"{FR_}/landing-eq",
    shell:
        vfloat_shell()


# The same with the mesh at y = -<mesh> mm.
rule firep_vfloat_mesh:
    input:
        cfg=FDRIFT,
        script="scripts/firep_landing.py",
    output:
        f"{FR_}/vfloat-m{{mesh}}.txt",
    params:
        out=f"{FR_}/landing-eq-m{{mesh}}",
    shell:
        vfloat_shell(" --set 'domain.bounds.y=[-{wildcards.mesh},204.71]'")


rule firep_weight:
    input:
        FWEIGHT,
    output:
        f"{FR_}/resp/weight-{{plane}}.pt",
    shell:
        "{ENV}; $DEMO_FIREP train -c {input} {FSET}"
        " --set problem.weighting.electrode={wildcards.plane} -o {output} -q"


rule firep_weight_mesh:
    input:
        FWEIGHT,
    output:
        f"{FR_}/resp/weight-{{plane}}-m{{mesh}}.pt",
    shell:
        "{ENV}; $DEMO_FIREP train -c {input} {FSET}"
        " --set problem.weighting.electrode={wildcards.plane}"
        " --set 'domain.bounds.y=[-{wildcards.mesh},204.71]' -o {output} -q"


# Prior names: BASE[m<mesh>][b], BASE a config["priors"] key or vw<V_W>;
# m<mesh> puts the mesh at y = -<mesh> mm (default config bad_apa.mesh_y_mm);
# b bin-averages a 51-impact response onto the six paths.
PRIOR_RE = re.compile(r"(?P<base>.+?)(?:m(?P<mesh>\d+(?:\.\d+)?))?(?P<b>b)?")


def prior_parse(name):
    m = PRIOR_RE.fullmatch(name)
    base, mesh, binavg = m.group("base"), m.group("mesh"), bool(m.group("b"))
    if base in config["priors"]:
        vw = config["priors"][base]["w_potential_V"]
    else:
        v = re.fullmatch(r"vw(-?\d+(?:\.\d+)?)", base)
        if not v:
            raise ValueError(f"unknown prior {name}")
        vw = float(v.group(1))
    return dict(vw=vw, mesh=mesh, binavg=binavg)


def vfloat_file(p):
    return f"{FR_}/vfloat.txt" if p["mesh"] is None else f"{FR_}/vfloat-m{p['mesh']}.txt"


def prior_vw_value(name):
    return prior_parse(name)["vw"]


def mesh_set(p):
    return "" if p["mesh"] is None else f" --set 'domain.bounds.y=[-{p['mesh']},204.71]'"


rule firep_drift:
    input:
        cfg=FDRIFT,
        vfloat=lambda w: [vfloat_file(prior_parse(w.name))]
            if prior_vw_value(w.name) == "float" else [],
    output:
        f"{FR_}/drift-{{name}}.pt",
    params:
        vw=lambda w: (f"$(cat {vfloat_file(prior_parse(w.name))})"
                      if prior_vw_value(w.name) == "float" else str(prior_vw_value(w.name))),
        mesh=lambda w: mesh_set(prior_parse(w.name)),
    shell:
        "{ENV}; $DEMO_FIREP train -c {input.cfg} {FSET}"
        " --set electrodes.3.bias={params.vw}{params.mesh} -o {output} -q"


def weight_files(name):
    p = prior_parse(name)
    suf = "" if p["mesh"] is None else f"-m{p['mesh']}"
    return [f"{FR_}/resp/weight-{pl}{suf}.pt" for pl in "uvw"]


rule firep_response:
    input:
        cfg=FDRIFT,
        drift=f"{FR_}/drift-{{name}}.pt",
        weights=lambda w: weight_files(w.name),
    output:
        f"{FR_}/resp/response-{{name}}.npz",
    log:
        f"{FR_}/resp/response-{{name}}.log",
    params:
        w=lambda w, input: " ".join(f"-w {p}" for p in input.weights),
        imp=lambda w: " --impacts 51" if prior_parse(w.name)["binavg"] else "",
        mesh=lambda w: mesh_set(prior_parse(w.name)),
    shell:
        "{ENV}; $DEMO_FIREP response -c {input.cfg} -d {input.drift} {params.w}"
        " --y-start 100 --set response.impact_nudge=0.025{params.imp}{params.mesh}"
        " -o {output} > {log} 2>&1"


rule prior:
    wildcard_constraints:
        name="vw[^/]*",
    input:
        cfg=FDRIFT,
        resp=f"{FR_}/resp/response-{{name}}.npz",
        script="scripts/firep_to_wct.py",
    output:
        f"{R}/prior/{{name}}.json.bz2",
    params:
        b=lambda w: " --bin-average" if prior_parse(w.name)["binavg"] else "",
    shell:
        "{ENV}; {PY} {input.script} {input.cfg} {input.resp} {output}{params.b}"


