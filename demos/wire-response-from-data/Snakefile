        " --anodes {A},{C} --tex {output.tex} --tag fv"


# S6: the fit sample and WCT-in-the-loop scans.  The simulation is linear in
# the field response and learner 1 has few parameters, so WCT itself serves as
# the (exact) forward model: each trial is a firep solve plus a WCT run on the
# fit subset of shots, anode 0 only.
FIT = config["fit"]


rule depos_fit:
    input:
        depos=rules.laser_depos.output.depos,
        script="scripts/subset.py",
    output:
        f"{R}/depos/fit.npz",
    shell:
        "{ENV}; {PY} {input.script} depos {input.depos} {output} --stride {FIT[stride]}"


# The same shots cut from the full pseudo-data (does not read the truth).
rule data_fit:
    input:
        frames=rules.data.output,
        script="scripts/subset.py",
    output:
        f"{R}/frames/fit/data.npz",
    shell:
        "{ENV}; {PY} {input.script} frames {input.frames} {output} --stride {FIT[stride]}"


rule sim_fit:
    input:
        depos=rules.depos_fit.output,
        fr=f"{R}/prior/{{name}}.json.bz2",
    output:
        f"{R}/frames/fit/{{name}}.npz",
    log:
        f"{R}/logs/sim_fit-{{name}}.log",
    shell:
        sim_shell("{input.fr}", anodes=[A])


def fit_frames(name):
    return f"{R}/frames/fit/{name}.npz"


VW_MODELS = {v: fit_frames(f"vw{v:g}") for v in FIT["vw_scan"]}
VWB_MODELS = {v: fit_frames(f"vw{v:g}b") for v in FIT["vw_scan"]}
MESH_MODELS = {m: fit_frames(f"vwfloatm{m:g}b") for m in FIT["mesh_scan"]}


def scan_shell(tag, models, param="$V_W$ [V]", true=None):
    spec = " ".join(f"{v:g}={p}" for v, p in models.items())
    t = f" --true {true}" if true is not None else ""
    return ("{ENV}; {PY} {input.script} {input.ref} {FIGS}"
            f" --tag {tag} --anode {A} --noise {FIT['noise_adc']}"
            f" --tmax {FIT['tmax_ticks']} --param '{param}'{t} -- " + spec + " > {log}")


# B1: pseudo-data from firep at the floating equilibrium; scan V_W.
rule scan_bone:
    input:
        ref=fit_frames("vwfloat"),
        vfloat=f"{FR_}/vfloat.txt",
        models=list(VW_MODELS.values()),
        script="scripts/scan_loss.py",
    output:
        f"{FIGS}/scan-scbone.tex",
        f"{FIGS}/scan-scbone.pdf",
    log:
        f"{R}/logs/scan-scbone.txt",
    shell:
        scan_shell("scbone", VW_MODELS, true="$(cat {input.vfloat})")


# B2 with learner 1: the Garfield-tuned pseudo-data; scan V_W (t0 profiled).
rule scan_btwo:
    input:
        ref=rules.data_fit.output,
        models=list(VW_MODELS.values()),
        script="scripts/scan_loss.py",
    output:
        f"{FIGS}/scan-scbtwo.tex",
        f"{FIGS}/scan-scbtwo.pdf",
    log:
        f"{R}/logs/scan-scbtwo.txt",
    shell:
        scan_shell("scbtwo", VW_MODELS)


# As scan_btwo with bin-averaged six-path tables.
rule scan_btwobin:
    input:
        ref=rules.data_fit.output,
        models=list(VWB_MODELS.values()),
        script="scripts/scan_loss.py",
    output:
        f"{FIGS}/scan-scbtwobin.tex",
        f"{FIGS}/scan-scbtwobin.pdf",
    log:
        f"{R}/logs/scan-scbtwobin.txt",
    shell:
        scan_shell("scbtwobin", VWB_MODELS)


# Mesh depth, W at its floating equilibrium for each, bin-averaged tables.
rule scan_mesh:
    input:
        ref=rules.data_fit.output,
