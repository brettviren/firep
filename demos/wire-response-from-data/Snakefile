        cfg="config.yaml",
        vfloat=f"{R}/firep/vfloat.txt",
        script="scripts/setup_macros.py",
    output:
        f"{FIGS}/setup.tex",
    shell:
        "{ENV}; {PY} {input.script} {input.cfg} {input.vfloat} {output}"


# Sec. 3: WCT anode vs online APA numbering.
rule apa_numbering:
    input:
